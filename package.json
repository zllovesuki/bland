{
  "name": "bland",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "emoji:generate": "node --import tsx scripts/generate-emoji-data.ts",
    "dev": "vite dev",
    "build": "vite build && vite build -c vite.sites.config.ts",
    "lint": "eslint src tests scripts vite.config.ts eslint.config.js",
    "typecheck": "npm run typecheck:client && npm run typecheck:worker && npm run typecheck:tests",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "typecheck:tests": "npm run typecheck:tests:client && npm run typecheck:tests:worker",
    "typecheck:tests:client": "tsc -p tests/tsconfig.client.json --noEmit",
    "typecheck:tests:worker": "tsc -p tests/tsconfig.worker.json --noEmit",
    "types:generate": "wrangler types --env-file .dev.vars.example",
    "test": "vitest run --passWithNoTests",
    "test:client": "vitest run --project client --project client-dom",
    "test:client-dom": "vitest run --project client-dom",
    "test:sites": "vitest run --project sites",
    "test:shared": "vitest run --project shared",
    "test:worker": "vitest run --project worker-unit --project worker-runtime",
    "test:worker-unit": "vitest run --project worker-unit",
    "test:worker-runtime": "vitest run --project worker-runtime",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:parallel": "BLAND_E2E_PARALLEL=1 playwright test -c tests/e2e/playwright.config.ts",
    "deploy": "npm run db:migrate:remote && npm run build && wrangler deploy",
    "db:generate:d1": "drizzle-kit generate --config=drizzle-d1.config.ts",
    "db:generate:docsync-do": "drizzle-kit generate --config=drizzle-docsync-do.config.ts",
    "db:generate:workspace-indexer": "drizzle-kit generate --config=drizzle-workspace-indexer.config.ts",
    "db:generate:durable": "npm run db:generate:docsync-do && npm run db:generate:workspace-indexer",
    "db:generate": "npm run db:generate:d1 && npm run db:generate:durable",
    "db:migrate:local": "wrangler d1 migrations apply bland-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply bland-prod --remote",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predev": "npm run emoji:generate",
    "prebuild": "npm run emoji:generate",
    "pretypecheck": "npm run emoji:generate",
    "pretest": "npm run emoji:generate"
  },
  "dependencies": {
    "@cf-wasm/png": "^0.4.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lucide/lab": "^0.2.0",
    "@sentry/react": "^10.74.0",
    "@serwist/window": "^9.5.12",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.34",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-character-count": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-collaboration": "3.31.3",
    "@tiptap/extension-collaboration-caret": "3.31.3",
    "@tiptap/extension-details": "3.31.3",
    "@tiptap/extension-drag-handle-react": "3.31.3",
    "@tiptap/extension-emoji": "3.31.3",
    "@tiptap/extension-file-handler": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
